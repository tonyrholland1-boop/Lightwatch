# LightWatch configuration
# Every value has a working default; override only what you need.

PORT=5173
NODE_ENV=development

# Where the SQLite file lives
DATA_DIR=./data

# Freshness thresholds (minutes)
FRESH_MINUTES=30
REPORT_WINDOW_MINUTES=120
AGREEMENT_WINDOW_MINUTES=30
AGREEMENT_MIN_REPORTS=2

# Abuse prevention
DUPLICATE_COOLDOWN_MINUTES=10
RATE_LIMIT_PER_AREA=3
RATE_LIMIT_WINDOW_MINUTES=30
RATE_LIMIT_DAILY=10

# Secret used to hash request fingerprints. Set a unique value in production.
FINGERPRINT_SALT=change-me-before-deploy

# Contact address shown in the FAQ and footer
CONTACT_EMAIL=feedback@lightwatch.ng

# Set to false to run with no demo reports
SEED_DEMO_DATA=true
